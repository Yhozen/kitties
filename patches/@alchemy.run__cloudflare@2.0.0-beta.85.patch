+import type { Json } from "@alchemy.run/domain/Platform";
+import type { RuntimeContext } from "alchemy/RuntimeContext";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import type { HttpServerRequest } from "effect/http/HttpServerRequest";
+import type { HttpServerResponse } from "effect/http/HttpServerResponse";
+import type * as Scope from "effect/Scope";
+import type { DurableObjectJurisdiction } from "../Workers/DurableObject.ts";
+import type { DurableObjectState } from "../Workers/DurableObjectState.ts";
+import type { WorkflowRunServices } from "../Workflows/Workflow.ts";
+
+/** Exact provider layout and model identity; never inferred from a sanitized class name. */
+export interface RecoveryModel {
+  readonly modelName: string;
+  readonly version: number | undefined;
+  readonly jurisdiction: DurableObjectJurisdiction | undefined;
+}
+
+/** The Worker's exact generated class/binding identity. */
+export interface RecoveryObject extends RecoveryModel {
+  readonly className: string;
+}
+
+export interface RecoveryStub {
+  readonly [method: string]: (...args: ReadonlyArray<unknown>) => Effect.Effect<unknown, unknown>;
+}
+
+/** Narrow first-party transport, including native identity derivation for discovery. */
+export interface RecoveryNamespace {
+  readonly idFromName: (name: string) => { readonly toString: () => string };
+  readonly getByName: (name: string) => RecoveryStub & {
+    readonly fetch: (request: HttpServerRequest) => Effect.Effect<HttpServerResponse, unknown>;
+  };
+  readonly jurisdiction: (jurisdiction: DurableObjectJurisdiction) => RecoveryNamespace;
+}
+
+/** Both native construction phases must remain behind the application's admission guard. */
+export type RecoveryObjectImpl = Effect.Effect<
+  Effect.Effect<Record<string, unknown>, never, DurableObjectState | RuntimeContext | Scope.Scope>,
+  never,
+  DurableObjectState
+>;
+
+export interface RecoveryHooksService {
+  readonly object: (object: RecoveryObject, next: RecoveryObjectImpl) => RecoveryObjectImpl;
+  readonly namespace: (object: RecoveryObject, next: RecoveryNamespace) => RecoveryNamespace;
+  /** Pure explicit deployment input. Never resolve credentials or current authority here. */
+  readonly backfillInput: (model: RecoveryModel) => Json;
+  /** Validate immutable native input before the first durable task; never rebind missing input. */
+  readonly backfill: <A, E, R>(
+    model: RecoveryModel,
+    input: Json | undefined,
+    next: Effect.Effect<A, E, R>,
+  ) => Effect.Effect<A, E, R | WorkflowRunServices>;
+}
+
+/** Opt in with `layerDurableObjects({ recovery: hooksLayer })`; share that Layer per Worker. */
+export class RecoveryHooks extends Context.Service<RecoveryHooks, RecoveryHooksService>()(
+  "alchemy/Cloudflare/Domain/RecoveryHooks",
+) {}
+
+/** Missing recovery input cannot reach any native backfill body or its first checkpoint. */
+export const withBackfillRecovery = <A, E, R>(
+  hooks: RecoveryHooksService,
+  model: RecoveryModel,
+  input: Json | undefined,
+  next: Effect.Effect<A, E, R>,
+): Effect.Effect<A, E, R | WorkflowRunServices> => input === undefined
+  ? Effect.die(new Error("DomainRecoveryInputMissing"))
+  : hooks.backfill(model, input, next);
+
+/** Creation payload shared by reconciliation and local transport probes. */
+export interface BackfillInput {
+  readonly targets: ReadonlyArray<string>;
+  readonly plans?: Readonly<Record<string, { readonly sources?: ReadonlyArray<string>; readonly singleSource: boolean }>>;
+  readonly recovery?: Json;
+}
+
+export const backfillParams = (input: BackfillInput) => ({
+  targets: input.targets,
+  plans: input.plans ?? {},
+  ...(input.recovery === undefined ? {} : { recovery: input.recovery }),
+});
