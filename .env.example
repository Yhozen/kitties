# Owner infrastructure environment. Keep real values in an untracked, protected file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BOAT_DEV_API_KEY=
# Reuse the existing encryption/release keys and stable deployment identity on redeploy.
# KITTIES_KEK is 32 bytes encoded as 64 lowercase hexadecimal digits; escrow it off Cloudflare.
KITTIES_KEK=
KITTIES_RELEASE_KEY=
KITTIES_DEPLOYMENT=
# Application-only publishing uses this restricted token instead of infrastructure credentials.
CLOUDFLARE_WORKER_DEPLOY_TOKEN=
# Optional: see docs/DEPLOY.md for stage defaults and Access settings.
# KITTIES_NEXT_DOMAIN=
# KITTIES_ACCESS_EMAIL=
# KITTIES_ACCESS_ISSUER=
# KITTIES_ACCESS_AUDIENCE=
# KITTIES_CHATGPT_ENABLED=false
