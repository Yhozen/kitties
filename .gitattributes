# Normalise line endings so a clone on any platform matches.
* text=auto eol=lf

# The shell scripts must keep LF and be executable.
*.sh text eol=lf
Makefile text eol=lf

# Binaries must never be touched by the line-ending conversion.
*.png binary

# Unified diffs require empty context lines, including at the end of a hunk.
patches/*.patch whitespace=-blank-at-eol,-blank-at-eof
