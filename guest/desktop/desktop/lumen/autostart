# The desktop's wallpaper and the icons on it (PCManFM draws them under the windows and leaves
# the shelf's space alone).
pcmanfm --desktop >/tmp/pcmanfm.log 2>&1 &

# Keep a previous Openbox session's user startup commands after migration.
if [ -f "$HOME/.config/openbox/autostart" ]; then
    sh "$HOME/.config/openbox/autostart" &
elif [ -f "$HOME/.config/openbox/autostart.sh" ]; then
    sh "$HOME/.config/openbox/autostart.sh" &
fi

# One persistent browser, shared by the desktop and the DOM tools.
kitty-open about:blank >/tmp/kitties-browser-start.log 2>&1 &
